; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Escape the Professor"
run/main_scene="uid://dnnvbq1dubml1"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size.mobile=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2

[xr]

openxr/extensions/hand_tracking=true
openxr/extensions/hand_tracking_unobstructed_data_source=true
shaders/enabled=true
; OpenXR must be enabled here or the engine never creates the OpenXR API on Quest.
; startup_alert=false keeps the desktop build launching without a headset (script falls back to desktop mode).
openxr/enabled=true
openxr/startup_alert=false
openxr/extensions/meta/passthrough=true
